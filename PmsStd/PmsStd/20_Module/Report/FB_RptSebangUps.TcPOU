<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_RptSebangUps" Id="{25f647f2-af7c-4a94-847f-4917f8e29aa9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_RptSebangUps // UPS 계측값 → UPS 보고값
VAR_INPUT
	i_stState : ST_UpsState; // 장비 상태
	i_nDeviceIndex : UDINT; // UPS 번호
END_VAR
VAR_OUTPUT
	q_stUps : ST_UpsPublish_V1; // UPS 보고값
	q_bValid : BOOL; // 유효한 장비 데이터
END_VAR
VAR
	_stEmpty : ST_UpsPublish_V1;
	_awWarn : ARRAY[0..7] OF WORD; // 워드별 경고장 비트 (I44~I51)
	_awFault : ARRAY[0..7] OF WORD; // 워드별 중고장 비트 (I44~I51)
	_i : INT;
	_b : INT; // 워드 안 비트 번호
	_wBit : WORD;
	_nWarnPos : INT; // 다음에 채울 Warning1 비트
	_nFault1Pos : INT; // 다음에 채울 Fault1 비트
	_nFault2Pos : INT; // 다음에 채울 Fault2 비트
END_VAR
VAR CONSTANT
	// 세방 맵 v3.2 Alarm Flag 색. 순서 = I44 입력, I45 정류부, I46 BBC, I47 출력, I48 인버터, I49 바이패스, I50 STATUS1, I51 STATUS2
	WARN_MASK : ARRAY[0..7] OF WORD := [16#0700, 16#0003, 16#0007, 16#00FF, 16#0000, 16#03FF, 16#0000, 16#0701]; // 경고장(노랑)
	FAULT_MASK : ARRAY[0..7] OF WORD := [16#F8FF, 16#667C, 16#0FB8, 16#3F00, 16#803F, 16#0000, 16#0081, 16#7800]; // 중고장(주황)
	FAULT1_LAST_WORD : INT := 2; // 중고장 I44~I46 → Fault1, I47~I51 → Fault2 (회사 eventMap)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[q_stUps := _stEmpty;
q_stUps.DeviceIndex := i_nDeviceIndex;
q_stUps.Status := 1; // b0 통신에러
q_bValid := i_stState.bValid;
IF NOT q_bValid THEN
	RETURN;
END_IF

// 명세 RD-UPS-02 (v2.20, 회사 eventMap '001.UPS 경고장비트맵'): 마스크로 거른 경고장·중고장 비트를
// 맵 워드 순서(I44→I51), 워드 안 비트 순서로 b0부터 빈칸 없이 채운다. 마스크 밖 비트(운전 상태·예약)는 버림
//   Warning1 = 경고장 30개 (I44·I45·I46·I47·I49·I51) b0~b29, Warning2·3 = 0
//   Fault1 = I44·I45·I46 중고장 30개 b0~b29, Fault2 = I47·I48·I50·I51 중고장 19개 b0~b18, Fault3 = 0
// 마스크가 바뀌면 그 뒤 비트 자리가 모두 밀리므로 eventMap도 같이 고쳐야 함
_nWarnPos := 0;
_nFault1Pos := 0;
_nFault2Pos := 0;
FOR _i := 0 TO 7 DO
	_awWarn[_i] := i_stState.awAlarmStatus[_i] AND WARN_MASK[_i];
	_awFault[_i] := i_stState.awAlarmStatus[_i] AND FAULT_MASK[_i];
	FOR _b := 0 TO 15 DO
		_wBit := SHL(WORD#1, _b);
		IF (WARN_MASK[_i] AND _wBit) <> 0 THEN
			IF (_awWarn[_i] AND _wBit) <> 0 THEN
				q_stUps.Warning1 := q_stUps.Warning1 OR SHL(UDINT#1, _nWarnPos);
			END_IF
			_nWarnPos := _nWarnPos + 1;
		END_IF
		IF (FAULT_MASK[_i] AND _wBit) <> 0 THEN
			IF _i <= FAULT1_LAST_WORD THEN
				IF (_awFault[_i] AND _wBit) <> 0 THEN
					q_stUps.Fault1 := q_stUps.Fault1 OR SHL(UDINT#1, _nFault1Pos);
				END_IF
				_nFault1Pos := _nFault1Pos + 1;
			ELSE
				IF (_awFault[_i] AND _wBit) <> 0 THEN
					q_stUps.Fault2 := q_stUps.Fault2 OR SHL(UDINT#1, _nFault2Pos);
				END_IF
				_nFault2Pos := _nFault2Pos + 1;
			END_IF
		END_IF
	END_FOR
END_FOR

// 명세 RD-UPS-01: 상태 칸 (인터페이스 08.UPS 2026-11-12). 맵 워드: I45 정류부, I46 BBC, I48 인버터, I50 STATUS1, I51 STATUS2
// 운전 모드 (명세 RD-UPS-01 v2.41, 사용자 결정 2026-11-23): PMS는 모드를 나누지 않음. OperationMode = 1 자동, SystemOperationMode = 0
q_stUps.SystemOperationMode := 0;
q_stUps.OperationMode := 1;
q_stUps.Status := 0;
q_stUps.Status.1 := (q_stUps.Warning1 OR q_stUps.Warning2 OR q_stUps.Warning3) <> 0; // 경고 있음
q_stUps.Status.2 := (q_stUps.Fault1 OR q_stUps.Fault2 OR q_stUps.Fault3) <> 0; // 고장 있음
q_stUps.Status.3 := i_stState.bEmergencyStop; // e-stop (I50 b0)
q_stUps.Status.4 := i_stState.wStatus1.13; // 충전 중 (I50 b13 Batt charg Flag)

q_stUps.UPS_ModeStatus := 0;
q_stUps.UPS_ModeStatus.0 := i_stState.nBatMode = 0; // 부동충전 (BAT Mode 값을 비트로 나눔)
q_stUps.UPS_ModeStatus.1 := i_stState.nBatMode = 1; // 균등충전
q_stUps.UPS_ModeStatus.2 := i_stState.nBatMode = 2; // 대기
q_stUps.UPS_ModeStatus.3 := i_stState.nBatMode = 3; // 주기적 방전
q_stUps.UPS_ModeStatus.4 := i_stState.nBatMode = 4; // 펄스 방전
q_stUps.UPS_ModeStatus.5 := i_stState.nBatMode = 5; // 간헐충전
q_stUps.UPS_ModeStatus.6 := i_stState.wRectAlarm.8; // 비상 방전 (I45 b8 Regen mode)
q_stUps.UPS_ModeStatus.7 := i_stState.bTemperatureEnabled; // 온도보상충전 (I51 b2, 다른 모드와 동시 가능)
q_stUps.UPS_ModeStatus.8 := i_stState.wInverterAlarm.7; // ECO 모드 (I48 b7)
q_stUps.UPS_ModeStatus.9 := i_stState.wStatus1.12; // PRLT 모드 (I50 b12)
q_stUps.UPS_ModeStatus.10 := i_stState.wStatus1.11; // Droop 모드 (I50 b11)
q_stUps.UPS_ModeStatus.11 := i_stState.wRectAlarm.15; // VSM 모드 (I45 b15)
q_stUps.UPS_ModeStatus.12 := i_stState.wRectAlarm.8; // Regen 모드 (I45 b8, b6과 같은 비트)

q_stUps.MCCB_Status := SHR(WORD_TO_UDINT(i_stState.wStatus1), 1) AND 16#3F; // I50 b1~b6 → b0~b5 (b5 Out C/B는 1이 개방)
q_stUps.MCCB_Status.6 := i_stState.wOpCode.3; // 배터리 MCCB Trip (H11 OP-CODE b3, 1 = Trip, 세방 회신 2026-11-25, 명세 RD-UPS-01 v2.50)

q_stUps.RectStatus := 0;
q_stUps.RectStatus.0 := i_stState.bRectOn; // 정류부 기동 (I45 b11)
q_stUps.RectStatus.1 := i_stState.bRectNormal; // 정류부 정상 (I45 b12)
q_stUps.RectStatus.2 := i_stState.wRectAlarm.8; // Regen (I45 b8, 비상 방전)

q_stUps.BBCStatus := 0;
q_stUps.BBCStatus.0 := i_stState.bBbcOn; // 배터리 컨버터 기동 (I46 b12)
q_stUps.BBCStatus.1 := i_stState.bBbcNormal; // 배터리 컨버터 정상 (I46 b13)

q_stUps.InverterStatus := 0;
q_stUps.InverterStatus.0 := i_stState.bInverterOn; // 인버터 기동 (I48 b6)
q_stUps.InverterStatus.1 := i_stState.bInverterNormal; // 인버터 정상 (I48 b14)
q_stUps.InverterStatus.2 := i_stState.bOnInverter; // 인버터 출력 (I48 b13)

q_stUps.BypassStatus := 0;
q_stUps.BypassStatus.0 := i_stState.bOnBypass; // 바이패스 출력 (I48 b12)

q_stUps.LineInputVoltage_R := i_stState.fInputVoltageRV;
q_stUps.LineInputVoltage_S := i_stState.fInputVoltageSV;
q_stUps.LineInputVoltage_T := i_stState.fInputVoltageTV;
q_stUps.InputFrequency := i_stState.fInputFrequencyHz;
q_stUps.InputCurrent_R := i_stState.fInputCurrentRA;
q_stUps.InputCurrent_S := i_stState.fInputCurrentSA;
q_stUps.InputCurrent_T := i_stState.fInputCurrentTA;
q_stUps.InverterVoltage_R := i_stState.fInverterVoltageRV;
q_stUps.InverterVoltage_S := i_stState.fInverterVoltageSV;
q_stUps.InverterVoltage_T := i_stState.fInverterVoltageTV;
q_stUps.InverterCurrent_R := i_stState.fInverterCurrentRA;
q_stUps.InverterCurrent_S := i_stState.fInverterCurrentSA;
q_stUps.InverterCurrent_T := i_stState.fInverterCurrentTA;
q_stUps.BypassLineVoltage_R := i_stState.fBypassVoltageRV;
q_stUps.BypassLineVoltage_S := i_stState.fBypassVoltageSV;
q_stUps.BypassLineVoltage_T := i_stState.fBypassVoltageTV;
q_stUps.BypassFrequency := i_stState.fBypassFrequencyHz;
q_stUps.LineOutputVoltage_R := i_stState.fOutputVoltageRV;
q_stUps.LineOutputVoltage_S := i_stState.fOutputVoltageSV;
q_stUps.LineOutputVoltage_T := i_stState.fOutputVoltageTV;
q_stUps.FrequencyOutput := i_stState.fOutputFrequencyHz;
q_stUps.OutputCurrent_R := i_stState.fOutputCurrentRA;
q_stUps.OutputCurrent_S := i_stState.fOutputCurrentSA;
q_stUps.OutputCurrent_T := i_stState.fOutputCurrentTA;
q_stUps.DcLinkVoltage := i_stState.fDcLinkVoltageV;
q_stUps.DcLinkVoltage_High := i_stState.fDcLinkHighVoltageV;
q_stUps.DcLinkVoltage_Low := i_stState.fDcLinkLowVoltageV;
q_stUps.BatteryVoltage := i_stState.fBatteryVoltageV;
q_stUps.BatteryCurrent := i_stState.fBatteryCurrentA;
q_stUps.MPI_A_Current := i_stState.fMpiCurrentAA;
q_stUps.MPI_B_Current := i_stState.fMpiCurrentBA;
q_stUps.MPI_C_Current := i_stState.fMpiCurrentCA;
q_stUps.InputApparentPower := i_stState.fInputApparentPowerKva;
q_stUps.OutputApparentPower := i_stState.fOutputApparentPowerKva;
q_stUps.OutputActivePower := i_stState.fOutputActivePowerKw;
q_stUps.Temp1 := i_stState.fTemperature1C;
q_stUps.Temp2 := i_stState.fTemperature2C;
q_stUps.Temp3 := i_stState.fTemperature3C;
q_stUps.Temp4 := i_stState.fTemperature4C;
q_stUps.Temp5 := i_stState.fTemperature5C;
q_stUps.Temp6 := i_stState.fBatteryRoomTemperatureC;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
